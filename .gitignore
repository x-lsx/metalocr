!/metalocr/annotations.py
!/metalocr/heat.py
!/metalocr/pipeline.py
!/metalocr/selection.py
!/models/
/models/*
!/models/LICENSE
!/models/NOTICE.md
!/models/PP-OCRv5_server_det/
/models/PP-OCRv5_server_det/*
!/models/PP-OCRv5_server_det/inference.json
!/models/PP-OCRv5_server_det/inference.pdiparams
!/models/PP-OCRv5_server_det/inference.yml
!/models/metal_rec_expand_20261117/
/models/metal_rec_expand_20261117/*
!/models/metal_rec_expand_20261117/inference/
/models/metal_rec_expand_20261117/inference/*
!/models/metal_rec_expand_20261117/inference/inference.json
!/models/metal_rec_expand_20261117/inference/inference.pdiparams
